xml_file = 'tuo_file.xml'  # Sostituisci con il percorso del tuo file MusicXML
start_sec = 83  # Secondo di inizio (1:23)
end_sec = 105  # Secondo di fine (1:45)

analizza_harmony(xml_file, start_sec, end_sec)
